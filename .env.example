# ============================================================
# Niskala — Docker Environment Variables (Template)
# ============================================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
# The .env file is read by docker-compose.yml.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_NAME="Niskala"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8031
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
# APP_KEY will be auto-generated on first boot if left empty
APP_KEY=

# ── Ports (host:container) ───────────────────────────────────
NGINX_PORT=8031
BACKEND_PORT=9003
FRONTEND_PORT=9004
DB_EXTERNAL_PORT=3320
MINIO_PORT=9005
MINIO_CONSOLE_PORT=9006

# ── Database (Internal Docker service) ───────────────────────
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=niskala
DB_USERNAME=niskala
DB_PASSWORD=niskala
# DB_ROOT_PASSWORD=

# ── Session ──────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ── Sanctum ──────────────────────────────────────────────────
SANCTUM_EXPIRATION=480
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_PREFIX=niskala_

# ── CORS ─────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:8031,http://localhost:9003,http://localhost:9004,http://127.0.0.1:8031,http://127.0.0.1:9003,http://127.0.0.1:9004
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,Origin,X-Requested-With
CORS_MAX_AGE=600
CORS_SUPPORTS_CREDENTIALS=false

# ── Admin Account (seeded on first boot) ─────────────────────
# Minimum 12 characters — change this before any real deployment
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=adminpassword123

# ── Logging ──────────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# ── Cache / Queue ────────────────────────────────────────────
CACHE_STORE=database
QUEUE_CONNECTION=database

# ── Object Storage (MinIO / S3) ──────────────────────────────
FILESYSTEM_DISK=s3
MINIO_ROOT_USER=niskala
MINIO_ROOT_PASSWORD=niskala_secret123
AWS_ACCESS_KEY_ID=niskala
AWS_SECRET_ACCESS_KEY=niskala_secret123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=niskala
AWS_URL=http://localhost:9005/niskala
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ── Swagger ──────────────────────────────────────────────────
L5_SWAGGER_GENERATE_ALWAYS=false
L5_SWAGGER_UI_PERSIST_AUTHORIZATION=false
